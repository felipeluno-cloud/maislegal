"use client";

import { useState, useMemo } from "react";
import { ArrowRight, Calculator, Building2, AlertTriangle, ShieldCheck } from "lucide-react";
import { Button } from "@/components/base/Button";
import { HeroLogoBg } from "@/components/base/HeroLogoBg";

function formatBRL(value: number) {
  return new Intl.NumberFormat("pt-BR", {
    style: "currency",
    currency: "BRL",
    maximumFractionDigits: 0
  }).format(value);
}

export default function CalculadoraPage() {
  const [contratos, setContratos] = useState(80);
  const [ticket, setTicket] = useState(50000);
  const [operadores, setOperadores] = useState(4);

  const calc = useMemo(() => {
    const portfolioAnual = contratos * ticket;

    // Hipóteses conservadoras baseadas em benchmarks de mercado
    const slaPerda = portfolioAnual * 0.025;             // 2,5% SLAs não cobrados
    const renovacaoPerda = portfolioAnual * 0.015;       // 1,5% renovações sem renegociação
    const reconstrucaoCusto = (contratos / 80) * 50000;  // R$50k por bloco de 80 contratos em disputas/ano
    const churnEvitavel = portfolioAnual * 0.03;         // 3% churn evitável por descuido

    const economiaTotal = slaPerda + renovacaoPerda + reconstrucaoCusto + churnEvitavel;

    const custoLegal = (operadores - 1) * 500 * 12; // operador 1 grátis, demais R$500/mês
    const ratio = custoLegal > 0 ? economiaTotal / custoLegal : 0;

    return {
      portfolioAnual,
      slaPerda,
      renovacaoPerda,
      reconstrucaoCusto,
      churnEvitavel,
      economiaTotal,
      custoLegal,
      ratio
    };
  }, [contratos, ticket, operadores]);

  return (
    <>
      <section className="relative overflow-hidden border-b border-stone-200 bg-white">
        <HeroLogoBg position="top-right" color="var(--brand)" opacity={0.06} />

        <div className="container-soma relative py-12 md:py-16">
          <div className="max-w-[820px]">
            <div className="mb-6 inline-flex items-center gap-2 rounded-full border border-brand/20 bg-brand-tint px-3 py-1.5">
              <Calculator className="size-4 text-brand" strokeWidth={2} />
              <span className="font-mono text-[11px] font-bold uppercase tracking-widest text-brand">
                Calculadora de ROI
              </span>
            </div>

            <h1 className="mb-4 font-title text-4xl font-bold tracking-tighter text-gray-900 md:text-5xl lg:text-[52px] leading-[1.05]">
              Quanto seu portfólio de contratos custa quando ninguém olha pra ele.
            </h1>

            <p className="text-lg leading-relaxed text-gray-600 md:text-xl">
              Estimativa <strong className="font-semibold text-gray-900">conservadora</strong> baseada em 4 fontes de perda invisível: SLAs não cobrados, renovações sem renegociação, reconstrução de histórico em disputas, e churn evitável por descuido contratual.
            </p>
          </div>
        </div>
      </section>

      <section className="bg-stone-50">
        <div className="container-soma section-soma">
          <div className="grid grid-cols-1 items-start gap-10 lg:grid-cols-[1fr_1.2fr]">
            {/* INPUTS */}
            <div className="rounded-2xl border-2 border-brand bg-white p-7 md:p-8">
              <p className="mb-1 font-mono text-[11px] font-bold uppercase tracking-widest text-brand">
                Sua operação
              </p>
              <p className="mb-7 text-[14px] leading-relaxed text-gray-600">
                Ajuste os 3 valores conforme o seu cenário. O cálculo é instantâneo.
              </p>

              <div className="space-y-7">
                <div>
                  <div className="mb-3 flex items-center justify-between">
                    <label className="font-title text-[15px] font-bold text-gray-900">
                      Contratos B2B ativos
                    </label>
                    <span
                      className="rounded-full bg-brand-tint px-3 py-1 font-mono text-sm font-bold text-brand"
                    >
                      {contratos}
                    </span>
                  </div>
                  <input
                    type="range"
                    min={10}
                    max={500}
                    step={10}
                    value={contratos}
                    onChange={(e) => setContratos(Number(e.target.value))}
                    className="w-full accent-brand"
                  />
                  <div className="mt-1 flex justify-between font-mono text-[10px] text-stone-500">
                    <span>10</span>
                    <span>500</span>
                  </div>
                </div>

                <div>
                  <div className="mb-3 flex items-center justify-between">
                    <label className="font-title text-[15px] font-bold text-gray-900">
                      Ticket médio anual por contrato
                    </label>
                    <span
                      className="rounded-full bg-brand-tint px-3 py-1 font-mono text-sm font-bold text-brand"
                    >
                      {formatBRL(ticket)}
                    </span>
                  </div>
                  <input
                    type="range"
                    min={5000}
                    max={500000}
                    step={5000}
                    value={ticket}
                    onChange={(e) => setTicket(Number(e.target.value))}
                    className="w-full accent-brand"
                  />
                  <div className="mt-1 flex justify-between font-mono text-[10px] text-stone-500">
                    <span>{formatBRL(5000)}</span>
                    <span>{formatBRL(500000)}</span>
                  </div>
                </div>

                <div>
                  <div className="mb-3 flex items-center justify-between">
                    <label className="font-title text-[15px] font-bold text-gray-900">
                      Operadores no time (incluindo você)
                    </label>
                    <span
                      className="rounded-full bg-brand-tint px-3 py-1 font-mono text-sm font-bold text-brand"
                    >
                      {operadores}
                    </span>
                  </div>
                  <input
                    type="range"
                    min={1}
                    max={20}
                    step={1}
                    value={operadores}
                    onChange={(e) => setOperadores(Number(e.target.value))}
                    className="w-full accent-brand"
                  />
                  <div className="mt-1 flex justify-between font-mono text-[10px] text-stone-500">
                    <span>1</span>
                    <span>20</span>
                  </div>
                </div>
              </div>

              <div className="mt-7 rounded-xl border border-stone-200 bg-stone-50 p-4">
                <p className="mb-1 font-mono text-[10px] font-bold uppercase tracking-widest text-stone-500">
                  Portfólio anual total
                </p>
                <p className="font-title text-2xl font-extrabold tracking-tight text-gray-900">
                  {formatBRL(calc.portfolioAnual)}
                </p>
              </div>
            </div>

            {/* OUTPUTS */}
            <div>
              {/* Resumo grande */}
              <div className="mb-6 rounded-2xl bg-brand p-7 text-white md:p-8">
                <p className="mb-2 font-mono text-[11px] font-bold uppercase tracking-widest text-white/70">
                  Estimativa anual de perda invisível
                </p>
                <p className="font-title text-4xl font-extrabold tracking-tight md:text-5xl lg:text-6xl">
                  {formatBRL(calc.economiaTotal)}
                </p>
                <p className="mt-3 text-[14px] leading-relaxed text-white/85">
                  Soma das 4 fontes de perda silenciosa em um portfólio do seu tamanho. Conservador.
                </p>
              </div>

              {/* 4 fontes */}
              <div className="mb-6 grid grid-cols-1 gap-3 md:grid-cols-2">
                {[
                  { label: "SLAs não cobrados", val: calc.slaPerda, sub: "2,5% do portfólio anual", icon: AlertTriangle },
                  { label: "Renovações sem renegociar", val: calc.renovacaoPerda, sub: "1,5% sem aviso prévio", icon: AlertTriangle },
                  { label: "Reconstrução em disputas", val: calc.reconstrucaoCusto, sub: "advogado + tempo do time", icon: AlertTriangle },
                  { label: "Churn evitável", val: calc.churnEvitavel, sub: "3% que sai por descuido contratual", icon: AlertTriangle }
                ].map((f) => {
                  const Icon = f.icon;
                  return (
                    <div
                      key={f.label}
                      className="rounded-xl border border-stone-200 bg-white p-5"
                    >
                      <div className="mb-3 flex items-center gap-2">
                        <Icon className="size-4 text-peach-dark" strokeWidth={1.6} />
                        <p className="font-mono text-[10px] font-bold uppercase tracking-widest text-peach-dark">
                          {f.label}
                        </p>
                      </div>
                      <p className="mb-1 font-title text-2xl font-extrabold tracking-tight text-peach-dark">
                        {formatBRL(f.val)}
                      </p>
                      <p className="text-[12px] leading-snug text-gray-600">{f.sub}</p>
                    </div>
                  );
                })}
              </div>

              {/* Custo da plataforma */}
              <div className="rounded-2xl border-2 border-stone-200 bg-white p-7">
                <div className="mb-5 flex items-center gap-2">
                  <ShieldCheck className="size-4 text-brand" strokeWidth={1.6} />
                  <p className="font-mono text-[11px] font-bold uppercase tracking-widest text-brand">
                    Custo da +legal_ no seu cenário
                  </p>
                </div>

                <div className="grid grid-cols-1 items-end gap-5 md:grid-cols-2">
                  <div>
                    <p className="mb-1 font-mono text-[10px] font-bold uppercase tracking-widest text-stone-500">
                      Plano Time
                    </p>
                    <p className="font-title text-3xl font-extrabold tracking-tight text-gray-900">
                      {formatBRL(calc.custoLegal)}
                      <span className="ml-1 text-base font-bold text-stone-500">/ano</span>
                    </p>
                    <p className="mt-1 text-[12px] leading-snug text-stone-600">
                      operador 1 grátis · {operadores > 1 ? `${operadores - 1} adicional${operadores - 1 > 1 ? "es" : ""}` : "nenhum adicional"} a R$500/mês
                    </p>
                  </div>

                  <div className="rounded-xl bg-emerald-50 p-4 text-center">
                    <p className="mb-1 font-mono text-[10px] font-bold uppercase tracking-widest text-emerald-700">
                      Cada R$ 1 investido recupera
                    </p>
                    <p className="font-title text-3xl font-extrabold text-emerald-700">
                      {calc.ratio > 0 ? `${calc.ratio.toFixed(0)}×` : "-"}
                    </p>
                    <p className="mt-1 text-[12px] leading-snug text-emerald-700">
                      em economia evitada
                    </p>
                  </div>
                </div>
              </div>

              <p className="mt-5 font-mono text-[11px] uppercase tracking-widest text-stone-500">
                Estimativa baseada em benchmarks de mercado · Não é projeção exata
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* PERSONAS DE EXEMPLO */}
      <section className="bg-white">
        <div className="container-soma section-soma">
          <div className="mb-10 max-w-[820px]">
            <p className="eyebrow mb-3 text-brand">3 cenários típicos</p>
            <h2 className="h-soma mb-4">
              A conta varia, mas a tese se mantém.
            </h2>
          </div>

          <div className="grid grid-cols-1 gap-5 md:grid-cols-3">
            {[
              {
                icon: Building2,
                persona: "PME · 1 sócio",
                cenario: "10 contratos B2B · ticket R$ 80k · 1 operador",
                economia: "R$ 152k/ano",
                custo: "R$ 0/mês",
                color: "var(--peach-dark)"
              },
              {
                icon: Building2,
                persona: "Operações · time de 4",
                cenario: "80 contratos B2B · ticket R$ 50k · 4 operadores",
                economia: "R$ 360k/ano",
                custo: "R$ 1.500/mês",
                color: "var(--brand)"
              },
              {
                icon: Building2,
                persona: "Escritório · 8 advogados",
                cenario: "200 contratos sob gestão · ticket R$ 80k · 8 operadores",
                economia: "R$ 1,4M/ano",
                custo: "R$ 1.750/mês",
                color: "var(--soma)"
              }
            ].map((c) => {
              const Icon = c.icon;
              return (
                <div
                  key={c.persona}
                  className="rounded-2xl border-2 bg-white p-6"
                  style={{ borderColor: `${c.color}33` }}
                >
                  <div
                    className="mb-4 flex size-10 items-center justify-center rounded-xl"
                    style={{ background: `${c.color}14` }}
                  >
                    <Icon className="size-5" strokeWidth={1.6} style={{ color: c.color }} />
                  </div>
                  <p
                    className="mb-1 font-mono text-[10px] font-bold uppercase tracking-widest"
                    style={{ color: c.color }}
                  >
                    {c.persona}
                  </p>
                  <p className="mb-4 text-[13px] leading-relaxed text-gray-700">{c.cenario}</p>
                  <div className="space-y-2 border-t border-stone-200 pt-4">
                    <div>
                      <p className="font-mono text-[10px] font-bold uppercase tracking-widest text-stone-500">
                        Economia
                      </p>
                      <p
                        className="font-title text-xl font-extrabold"
                        style={{ color: c.color }}
                      >
                        {c.economia}
                      </p>
                    </div>
                    <div>
                      <p className="font-mono text-[10px] font-bold uppercase tracking-widest text-stone-500">
                        Custo +legal_
                      </p>
                      <p className="font-title text-base font-bold text-gray-900">{c.custo}</p>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </section>

      {/* CTA */}
      <section className="bg-brand text-white">
        <div className="container-soma py-14 md:py-16">
          <div className="mx-auto max-w-[760px] text-center">
            <p className="eyebrow-light mb-4">Próximo passo</p>
            <h2 className="mb-5 font-title text-2xl font-bold tracking-tighter md:text-3xl">
              Sua conta diz que vale a pena. E agora?
            </h2>
            <p className="mx-auto mb-8 max-w-[560px] text-[15px] leading-relaxed text-white/85">
              Conversa de 30 minutos com a equipe pra entender se o cálculo bate com o seu cenário, ou entra direto pelo Early Access com 1 operador grátis.
            </p>

            <div className="flex flex-wrap justify-center gap-3">
              <Button href="/agendar" variant="primary" size="lg" className="!bg-white !text-brand hover:!bg-stone-100">
                Agendar conversa <ArrowRight className="size-4" />
              </Button>
              <Button href="/early-access" variant="secondary" size="lg" className="!bg-transparent !border-white/40 !text-white hover:!bg-white/10 hover:!border-white">
                Entrar para o Early Access
              </Button>
            </div>
          </div>
        </div>
      </section>
    </>
  );
}
